# ---------------------------------------------------------------------------
# Moda Davetiye — ortam değişkenleri şablonu
#
# Bu dosya repo'ya girer, GERÇEK DEĞER İÇERMEZ.
# Kurulum:  cp .env.example .env   →  sonra .env içindeki boşlukları doldur.
# .env asla commit edilmez (.gitignore).
# ---------------------------------------------------------------------------

# --- Uygulama ---------------------------------------------------------------
# Tarayıcıda görünen taban adres. Yerelde port 3000, canlıda gerçek domain.
# E-postalardaki ve paylaşım görselindeki bağlantılar bunu kullanır.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
#
# Bu ikisi ZORUNLU. Boşken site çalışır ama sipariş/panel ekranları
# "Supabase yapılandırılmadı" uyarısı gösterir.
NEXT_PUBLIC_SUPABASE_URL="https://PROJE_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# OPSİYONEL. Yalnızca admin panelindeki "Müşteriye Bildirim Gönder" için
# gerekli — müşterinin e-posta adresi auth.users tablosunda ve anon anahtar
# RLS yüzünden orayı göremiyor.
#
# DİKKAT: service_role anahtarı satır güvenliğini (RLS) TAMAMEN atlar.
# Yalnızca sunucuda kullanılır, asla NEXT_PUBLIC_ ön ekiyle tanımlanmaz.
SUPABASE_SERVICE_ROLE_KEY=""


# --- E-posta (Resend) -------------------------------------------------------
# resend.com → API Keys.
# Boş bırakılırsa e-posta gönderilmez, konsola loglanır — sipariş akışı
# yine uçtan uca çalışır.
RESEND_API_KEY=""

# Domain alınıp Resend'de doğrulanana kadar gönderim yalnızca
# onboarding@resend.dev adresinden ve yalnızca kendi hesap e-postana yapılır.
# Doğrulandıktan sonra: "Moda Davetiye <merhaba@modavetiye.com>"
EMAIL_FROM="Moda Davetiye <onboarding@resend.dev>"

# Yeni sipariş bildirimlerinin düşeceği ekip adresi
EMAIL_ADMIN=""


# ---------------------------------------------------------------------------
# GEREKMEYENLER — bilerek burada değil
#
# DATABASE_URL / DIRECT_URL : Prisma, Drizzle gibi doğrudan Postgres'e
#   bağlanan ORM'ler için gerekir. Biz supabase-js ile REST API üzerinden
#   çalışıyoruz, veritabanına doğrudan bağlanmıyoruz. İleride ORM eklenirse
#   Supabase → Settings → Database → Connection string'den alınır.
#
# AUTH_SECRET : NextAuth'un oturum çerezini imzalamak için kullandığı
#   anahtar. Supabase Auth kendi JWT'sini kendi anahtarıyla imzaladığı için
#   bize gerekmiyor.
#
# IYZICO_* : Ödeme entegrasyonu ertelendi.
# ---------------------------------------------------------------------------
