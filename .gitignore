# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ama şablon dosyası repo'da kalmalı
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable görsel doğrulama çıktıları
.shots/

# görsel doğrulama çıktısı — 14 MB ekran görüntüsü, üretilebilir
/.shots/
/.shots-tema/
